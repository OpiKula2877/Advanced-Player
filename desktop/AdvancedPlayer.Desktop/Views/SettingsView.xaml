<UserControl x:Class="AdvancedPlayer.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdvancedPlayer.Desktop"
             Background="{StaticResource BgBrush}">
    <ScrollViewer Margin="22,18,22,12" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock x:Name="FoldersTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox x:Name="FolderList" Height="150" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddFolderButton" Click="AddFolder_Click"/>
                <Button x:Name="RemoveFolderButton" Click="RemoveFolder_Click"/>
                <Button x:Name="ScanButton" Click="Scan_Click"/>
            </StackPanel>
            <TextBlock x:Name="LanguageTitle" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,6"/>
            <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="Language_Changed"/>
            <TextBlock x:Name="RestartHint" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            <TextBlock x:Name="AboutText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,30,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
