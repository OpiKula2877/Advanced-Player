<Window x:Class="AdvancedPlayer.Desktop.Views.SongPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdvancedPlayer.Desktop"
        Title="{Binding [pick_song], Source={x:Static local:Loc.Instance}}"
        Width="640" Height="580" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,12" TextChanged="Search_TextChanged"
                 ToolTip="{Binding [search], Source={x:Static local:Loc.Instance}}"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="AddButton" Click="Add_Click" IsDefault="True"/>
            <Button x:Name="CloseButton" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        <ListBox x:Name="ResultList" SelectionMode="Extended" ItemTemplate="{StaticResource TrackRow}"
                 MouseDoubleClick="Result_MouseDoubleClick"/>
    </DockPanel>
</Window>
