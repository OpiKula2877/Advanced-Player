<UserControl x:Class="AdvancedPlayer.Desktop.Views.GroupListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdvancedPlayer.Desktop"
             Background="{StaticResource BgBrush}">
    <DockPanel Margin="22,18,22,12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="NewButton" HorizontalAlignment="Right" Visibility="Collapsed" Click="New_Click"
                    Content="{Binding [new_playlist], Source={x:Static local:Loc.Instance}}"/>
        </Grid>
        <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="58" Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="5" Background="{StaticResource Surface2Brush}" ClipToBounds="True" HorizontalAlignment="Left">
                            <Grid>
                                <TextBlock Text="♪" FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding ArtPath, Converter={StaticResource ArtConverter}}" Stretch="UniformToFill"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
