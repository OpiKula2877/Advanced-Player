<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>setup</AssemblyName>
    <RootNamespace>AdvancedPlayer.Setup</RootNamespace>
    <Version>1.3.0</Version>
    <ApplicationIcon>..\..\AdvancedPlayer.Desktop\AdvancedPlayer.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The zipped app, written by build-installer.ps1. Without it the setup has nothing to install. -->
    <EmbeddedResource Include="..\dist\payload.zip" LogicalName="payload.zip" Condition="Exists('..\dist\payload.zip')" />
  </ItemGroup>

</Project>
